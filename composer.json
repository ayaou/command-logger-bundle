{
  "name": "ayaou/command-logger-bundle",
  "type": "symfony-bundle",
  "description": "This bundle logs all commands executed with console, along with their execution time and errors if applied.",
  "keywords": ["symfony", "command", "logger", "log"],
  "homepage": "https://github.com/ayaou/command-logger-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohamed AYAOU",
      "email": "ayaou.mohammed@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "doctrine/doctrine-bundle": "^2 || ^3",
    "doctrine/orm": "^2 || ^3",
    "psr/log": "^1 || ^2 || ^3",
    "symfony/console": "6.4.* || 7.4.* || ^8",
    "symfony/dependency-injection": "6.4.* || 7.4.* || ^8",
    "symfony/event-dispatcher": "6.4.* || 7.4.* || ^8",
    "symfony/framework-bundle": "6.4.* || 7.4.* || ^8",
    "symfony/http-foundation": "6.4.* || 7.4.* || ^8",
    "symfony/http-kernel": "6.4.* || 7.4.* || ^8",
    "symfony/property-access": "6.4.* || 7.4.* || ^8",
    "symfony/property-info": "6.4.* || 7.4.* || ^8",
    "symfony/routing": "6.4.* || 7.4.* || ^8",
    "symfony/serializer": "6.4.* || 7.4.* || ^8",
    "symfony/uid": "6.4.* || 7.4.* || ^8",
    "symfony/validator": "6.4.* || 7.4.* || ^8",
    "symfony/yaml": "6.4.* || 7.4.* || ^8"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "rector/rector": "*",
    "friendsofphp/php-cs-fixer": "*",
    "phpstan/phpstan-symfony": "*",
    "roave/security-advisories": "dev-latest",
    "symfony/phpunit-bridge": "6.4.* || 7.4.* || ^8"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Ayaou\\CommandLoggerBundle\\": "src/",
      "Ayaou\\CommandLoggerBundle\\Tests\\": "tests/"
    }
  }
}
